// Resource script for TLauncher.exe (compiled via Windows SDK rc.exe in build.rs)
// Note: RT_MANIFEST is embedded separately via /MANIFEST:EMBED in build.rs.

1 ICON "assets/app.ico"

1 VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x00000001L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TLauncher contributors"
            VALUE "FileDescription",  "TLauncher - Desktop, Dock and Stage Manager"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "TLauncher"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Deskland authors & Deskland-VN contributors (GPL-3.0)"
            VALUE "OriginalFilename", "TLauncher.exe"
            VALUE "ProductName",      "TLauncher"
            VALUE "ProductVersion",   "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
